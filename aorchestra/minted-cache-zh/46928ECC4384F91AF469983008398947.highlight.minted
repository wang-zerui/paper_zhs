\begin{MintedVerbatim}[commandchars=\\\{\}]

\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{==== 进度 ====}
\PYG{l+s+sd}{[步骤 \PYGZob{}current\PYGZus{}step\PYGZcb{}/\PYGZob{}max\PYGZus{}steps\PYGZcb{}] 剩余：\PYGZob{}remaining\PYGZus{}steps\PYGZcb{} 步}
\PYG{l+s+sd}{\PYGZob{}budget\PYGZus{}warning\PYGZcb{}}
\PYG{l+s+sd}{若步数耗尽前未执行 \PYGZdq{}finish\PYGZdq{}，你的工作将丢失，并被标记为超时。}

\PYG{l+s+sd}{==== 你的任务（来自 MainAgent）====}
\PYG{l+s+sd}{\PYGZob{}task\PYGZus{}instruction\PYGZcb{}}

\PYG{l+s+sd}{==== 上下文（来自此前尝试）====}
\PYG{l+s+sd}{\PYGZob{}context\PYGZcb{}}
\PYG{l+s+sd}{请利用这些信息：重复有效步骤，避免失败尝试。}

\PYG{l+s+sd}{==== 原始问题（供参考）====}
\PYG{l+s+sd}{\PYGZob{}original\PYGZus{}question\PYGZcb{}}

\PYG{l+s+sd}{==== 动作空间 ====}
\PYG{l+s+sd}{\PYGZob{}action\PYGZus{}space\PYGZcb{}}

\PYG{l+s+sd}{==== 记忆 ====}
\PYG{l+s+sd}{近期记忆：}
\PYG{l+s+sd}{\PYGZob{}memory\PYGZcb{}}

\PYG{l+s+sd}{==== 当前观测 ====}
\PYG{l+s+sd}{\PYGZob{}obs\PYGZcb{}}

\PYG{l+s+sd}{==== 思考 ====}
\PYG{l+s+sd}{输出动作前逐步思考，并把关键推理写入 memory，供后续步骤使用。}

\PYG{l+s+sd}{==== 动作指南 ====}
\PYG{l+s+sd}{你可以使用两种动作：}

\PYG{l+s+sd}{1. **execute** \PYGZhy{} 运行 shell 命令并观测结果}
\PYG{l+s+sd}{   \PYGZhy{} 用于安装软件包、配置服务、核验状态等}
\PYG{l+s+sd}{   \PYGZhy{} 示例：\PYGZdq{}apt update \PYGZam{}\PYGZam{} apt install \PYGZhy{}y nginx\PYGZdq{}}

\PYG{l+s+sd}{2. **finish** \PYGZhy{} 向 MainAgent 报告进度}
\PYG{l+s+sd}{   \PYGZhy{} 任务完成时使用（status=\PYGZdq{}done\PYGZdq{}）}
\PYG{l+s+sd}{   \PYGZhy{} 已取得进展但仍需继续时使用（status=\PYGZdq{}partial\PYGZdq{}）}
\PYG{l+s+sd}{   \PYGZhy{} 必须在步数耗尽前使用！若超时，你的工作将丢失。}

\PYG{l+s+sd}{**finish 中应报告的内容：**}
\PYG{l+s+sd}{\PYGZhy{} completed：列出成功且有效的步骤（例如，[\PYGZdq{}apt update 成功\PYGZdq{}, \PYGZdq{}nginx 已安装\PYGZdq{}]）}
\PYG{l+s+sd}{\PYGZhy{} issues：列出失败的尝试及原因（例如，[\PYGZdq{}nginx \PYGZhy{}v 失败：找不到命令\PYGZdq{}]）}
\PYG{l+s+sd}{\PYGZhy{} message：简要总结当前状态}

\PYG{l+s+sd}{这些信息有助于下一个 SubAgent 判断应重复哪些步骤、避免哪些做法。}

\PYG{l+s+sd}{==== 输出格式 ====}
\PYG{l+s+sd}{关键要求：只能回复一个 JSON 对象，不得包含解释、Markdown 或其他文本。}

\PYG{l+s+sd}{使用 execute：}
\PYG{l+s+sd}{\PYGZob{}\PYGZob{}\PYGZdq{}action\PYGZdq{}: \PYGZdq{}execute\PYGZdq{}, \PYGZdq{}params\PYGZdq{}: \PYGZob{}\PYGZob{}\PYGZdq{}command\PYGZdq{}: \PYGZdq{}你的 shell 命令\PYGZdq{}\PYGZcb{}\PYGZcb{}, \PYGZdq{}memory\PYGZdq{}: \PYGZdq{}关键发现\PYGZdq{}\PYGZcb{}\PYGZcb{}}

\PYG{l+s+sd}{使用 finish：}
\PYG{l+s+sd}{\PYGZob{}\PYGZob{}\PYGZdq{}action\PYGZdq{}: \PYGZdq{}finish\PYGZdq{}, \PYGZdq{}params\PYGZdq{}: \PYGZob{}\PYGZob{}\PYGZdq{}status\PYGZdq{}: \PYGZdq{}done|partial\PYGZdq{}, \PYGZdq{}completed\PYGZdq{}: [...],}

\PYG{l+s+sd}{\PYGZdq{}issues\PYGZdq{}: [...], \PYGZdq{}message\PYGZdq{}: \PYGZdq{}...\PYGZdq{}\PYGZcb{}\PYGZcb{}, \PYGZdq{}memory\PYGZdq{}: \PYGZdq{}最终记录\PYGZdq{}\PYGZcb{}\PYGZcb{}}


\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}

\end{MintedVerbatim}
