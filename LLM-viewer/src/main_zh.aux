\citation{zhao2023survey}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {高效 LLM 推理综述思维导图。}本综述不同于传统综述，重点关注 LLM 推理的工程实践问题。我们首先识别并分析 LLM 推理挑战，然后引入定制化 Roofline 模型定位瓶颈（Sec.\ref {sec:challenges}）。随后将推理效率优化分为四个方向：参数压缩（Sec.\ref {sec:compression}）、快速解码算法（Sec.\ref {sec:fast-decoding}）、系统级优化（Sec.\ref {sec:system_optimization}）与硬件级优化（Sec.\ref {sec:hardware-optimization}）。}}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig:mindmap}{{2}{2}{\textbf {高效 LLM 推理综述思维导图。}本综述不同于传统综述，重点关注 LLM 推理的工程实践问题。我们首先识别并分析 LLM 推理挑战，然后引入定制化 Roofline 模型定位瓶颈（Sec.\ref {sec:challenges}）。随后将推理效率优化分为四个方向：参数压缩（Sec.\ref {sec:compression}）、快速解码算法（Sec.\ref {sec:fast-decoding}）、系统级优化（Sec.\ref {sec:system_optimization}）与硬件级优化（Sec.\ref {sec:hardware-optimization}）。}{figure.caption.2}{}}
\newlabel{fig:mindmap@cref}{{[figure][2][]2}{[1][1][]2}{}{}{}}
