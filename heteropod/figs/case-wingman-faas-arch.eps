/FontName /ArialMT def
/PaintType 0 def
/Encoding 256 array 0 1 255 {1 index exch/.notdef put} for
dup 33 /D put
dup 34 /P put
dup 35 /U put
dup 36 /space put
dup 37 /O put
dup 38 /S put
dup 39 /H put
